{
  "name": "strata-readiness-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "npm run build && node server.mjs",
    "db:start": "node scripts/local-db.mjs",
    "db:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": { "typescript": "~5.9.3" }
}
