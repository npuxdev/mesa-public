# Copy into .env.local. Never expose either server credential to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local Supabase credentials are discovered from `supabase status -o json`.
# Optional explicit local-only overrides:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=
